# ObraSegura API - Environment Configuration

# Porta do servidor
PORT=8080

# OpenAI API Key
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo de IA para chat e texto
OPENAI_MODEL=gpt-5.6-luna

# Modelo de visão para análise de imagens
OPENAI_VISION_MODEL=gpt-5.6-luna

# CORS Configuration
CORS_ORIGIN=*
