# Porta do servidor
PORT=8080

# OpenAI API Configuration
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_chave_aqui

# Modelo de texto da OpenAI
OPENAI_MODEL=gpt-4o

# Modelo de visão (análise de imagens) da OpenAI
OPENAI_VISION_MODEL=gpt-4o

# CORS - configurar para o URL do Flutter em produção
CORS_ORIGIN=*