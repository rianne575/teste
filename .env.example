# ======================================
# ObraSegura API - Variáveis de Ambiente
# ======================================

# Porta do servidor
PORT=8080

# OpenAI Configuration
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_chave_da_openai_aqui

# Modelo de IA para chat e texto
# Modelos recomendados: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o

# Modelo de visão para análise de imagens
# Modelos com visão: gpt-4o, gpt-4-turbo
OPENAI_VISION_MODEL=gpt-4o

# CORS - Configurar para o URL do Flutter em produção
# Exemplo: https://seu-app.com
# Desenvolvimento: *
CORS_ORIGIN=*
